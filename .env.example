APP_NAME="Dyno Focus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="vice-ceo@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Dyno Focus · AI Vice CEO
# ---------------------------------------------------------------------------
VICE_CEO_TIMEZONE=Asia/Kuala_Lumpur
# Master switch for scheduled briefings/reminders. Keep false in development.
VICE_CEO_AUTOMATIONS_ENABLED=false
VICE_CEO_APPROVAL_TTL_HOURS=24
VICE_CEO_REGISTRATION_ENABLED=true

# AI reasoning (Claude). Without a key the app uses deterministic rules.
VICE_CEO_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
VICE_CEO_AI_MODEL=claude-opus-5-5
VICE_CEO_AI_EFFORT=low

# WhatsApp: "log" = mock transport (nothing leaves the server). "meta" = official Cloud API.
WHATSAPP_DRIVER=log
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=60
# Approved templates (one {{1}} body parameter) used outside the 24-hour window.
WHATSAPP_TEMPLATE_LANGUAGE=ms
WHATSAPP_TEMPLATE_CEO_UPDATE=
WHATSAPP_TEMPLATE_CUSTOMER_FOLLOWUP=
